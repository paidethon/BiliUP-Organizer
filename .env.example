# BiliUP Organizer environment template.
# Copy to .env and fill in. NEVER commit real secrets.

APP_ENV=development            # development | production | test
APP_HOST=127.0.0.1
APP_PORT=8066
DATA_DIR=./data
WEB_DIST=                      # optional: path to built frontend (defaults to apps/web/dist)
DEMO_MODE=0                    # 1 = synthetic data, no external calls (dev/e2e only)
ENABLE_SCHEDULER=1
LOG_LEVEL=INFO

# Initial admin (recommended: leave empty and use the first-run /auth/setup flow)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_SECRET_KEY=                # random string; used for cookie signing context

# Default AI provider (OpenAI-compatible). Also configurable in Settings UI.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Default SMTP (also configurable in Settings UI)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=1

# Default LumiRSS integration (also configurable in Settings UI)
LUMIRSS_BASE_URL=
LUMIRSS_TOKEN=
LUMIRSS_INBOX_ENDPOINT=
